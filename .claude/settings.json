{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/tools/flow_guard.py scan --event SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*[Rr]oblox.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/tools/flow_guard.py pre",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/tools/flow_guard.py scan --event Stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/tools/studio_pull.py --quiet; python3 \"${CLAUDE_PROJECT_DIR}\"/tools/ship.py save --quiet",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
